---
// Title band of the institutional pages: breadcrumb, label, title and intro text.
// With `imagem` (a file in src/assets/img/) the photo goes behind a dark overlay.
import { Image } from 'astro:assets';
import { url } from '../lib/site.mjs';
import { imagem as buscarImagem } from '../lib/imagens.mjs';

interface Props {
  titulo: string;
  rotulo?: string;
  texto?: string;
  imagem?: string;
}

const { titulo, rotulo, texto, imagem } = Astro.props;
---

<section class:list={['cabecalho-pagina', { 'com-foto': imagem }]}>
  {imagem && <Image src={buscarImagem(imagem)} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="cabecalho-foto" loading="eager" />}
  <div class="container">
    <nav aria-label="Você está em">
      <ol class="trilha">
        <li><a href={url('/')}>Início</a></li>
        <li aria-current="page">{titulo}</li>
      </ol>
    </nav>
    {rotulo && <span class="rotulo">{rotulo}</span>}
    <h1>{titulo}</h1>
    {texto && <p>{texto}</p>}
    <slot />
  </div>
</section>

<style>
  .cabecalho-pagina {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 6vw, 72px);
    background:
      radial-gradient(circle at 90% 10%, rgb(205 23 25 / 0.08), transparent 40%),
      var(--cinza);
  }

  .cabecalho-pagina .container {
    position: relative;
    z-index: 2;
  }

  .trilha {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 20px;
    padding: 0;
    color: var(--suave);
    font-size: 14px;
    list-style: none;
  }

  .trilha li + li::before {
    content: '/';
    margin-right: 6px;
    opacity: 0.6;
  }

  .trilha a {
    color: inherit;
    text-decoration: none;
  }

  .trilha a:hover {
    color: var(--vermelho);
  }

  h1 {
    max-width: 820px;
    margin-bottom: 0.3em;
    font-size: clamp(2.1rem, 1.6rem + 2vw, 3.2rem);
  }

  p {
    max-width: 720px;
    margin: 0;
    color: var(--suave);
    font-size: 1.15rem;
  }

  .com-foto {
    padding-block: clamp(64px, 10vw, 120px);
    color: var(--branco);
  }

  .com-foto :global(.cabecalho-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .com-foto::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgb(17 24 39 / 0.85) 0%, rgb(17 24 39 / 0.55) 60%, rgb(17 24 39 / 0.3) 100%);
  }

  .com-foto h1,
  .com-foto .rotulo {
    color: var(--branco);
  }

  .com-foto p,
  .com-foto .trilha {
    color: rgb(255 255 255 / 0.85);
  }
</style>
