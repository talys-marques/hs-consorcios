---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import LinhaDoTempo from '../components/LinhaDoTempo.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import grupoHerval from '../assets/img/grupo-herval.jpg';
import trabalhe1 from '../assets/img/trabalhe-conosco-1.jpg';
import trabalhe2 from '../assets/img/trabalhe-conosco-2.jpg';
import { url } from '../lib/site.mjs';

const DESTAQUES = [
  { valor: '1993', texto: 'Ano de fundação' },
  { valor: '+ de 900', texto: 'parceiros no Brasil e no exterior' },
  { valor: 'até R$ 16 mi', texto: 'em crédito para imóveis, com prazos de até 240 meses' },
  { valor: 'até R$ 4 mi', texto: 'em crédito para veículos, com prazos de até 140 meses' },
];

const VALORES = [
  { icone: 'usuarios', titulo: 'Colaboradores', texto: 'Respeito à pessoa acima de tudo. Desenvolvendo a capacitação, auto estima, espírito de cooperação e trabalho em equipe.' },
  { icone: 'aperto', titulo: 'Fornecedores e Corretores', texto: 'Estreitar as parcerias para juntos alcançarmos excelentes níveis de competitividade.' },
  { icone: 'tendencia', titulo: 'Melhoria Contínua', texto: 'Buscar incessantemente pela superação, fazendo de eventuais erros uma oportunidade para melhoria e crescimento.' },
  { icone: 'coracao', titulo: 'Clientes', texto: 'Concentrar nossos esforços para superar as expectativas dos clientes externos e internos.' },
  { icone: 'dinheiro', titulo: 'Lucro', texto: 'Obter lucro é vital e necessário para novos investimentos, geração de empregos, segurança e bem estar social dos acionistas e colaboradores.' },
  { icone: 'escudo', titulo: 'Princípios', texto: 'Seriedade, Ética e Competência.' },
];

// Newest first. `arquivo` is in public/documentos/
const DEMONSTRACOES = [
  { titulo: '1º semestre de 2026', arquivo: 'demonstracoes-2026-06' },
  { titulo: 'Anual 2025', arquivo: 'demonstracoes-2025-12' },
  { titulo: '1º semestre de 2025', arquivo: 'demonstracoes-2025-06' },
  { titulo: 'Anual 2024', arquivo: 'demonstracoes-2024-12' },
  { titulo: '1º semestre de 2024', arquivo: 'demonstracoes-2024-06' },
  { titulo: 'Anual 2023', arquivo: 'demonstracoes-2023-12' },
  { titulo: 'Anual 2022', arquivo: 'demonstracoes-2022-12' },
  { titulo: 'Anual 2021', arquivo: 'demonstracoes-2021-12' },
  { titulo: '1º semestre de 2021', arquivo: 'demonstracoes-2021-06' },
  { titulo: '1º semestre de 2020', arquivo: 'demonstracoes-2020-06' },
];

const OUVIDORIA = [
  ['2026', '1'], ['2025', '2'], ['2025', '1'], ['2024', '2'], ['2024', '1'], ['2023', '2'], ['2023', '1'], ['2022', '2'], ['2022', '1'], ['2021', '2'],
].map(([ano, semestre]) => ({ titulo: `${semestre}º semestre de ${ano}`, arquivo: `ouvidoria-${ano}-${semestre}` }));
---

<Base titulo="Sobre nós" descricao="Fundada em 1993 e parte do Grupo Herval, a HS Consórcios é a maior administradora independente de consórcios do Brasil nos segmentos de veículos e imóveis.">
  <Banner nome="hero-sobre-nos" alt="O que cabe em 30 anos de história? Saiba tudo sobre a HS Consórcios." prioridade />

  <section class="secao">
    <div class="container sobre">
      <div>
        <span class="rotulo">Quem somos</span>
        <h1>Sobre nós</h1>
        <p class="destaque-texto">
          Fundada em 1993, a HS Consórcios é uma administradora consolidada e referência no mercado brasileiro, com mais de 900 parceiros presentes em todo o
          país e no exterior. Fazemos parte do Grupo Herval, que atua nos segmentos de comércio, serviços e indústria há mais de 65 anos.
        </p>
        <p>
          Somos especializados em oferecer soluções financeiras para quem busca conquistar seus objetivos de forma planejada e segura. Somos a maior
          administradora independente de consórcios do Brasil nos segmentos de veículos e imóveis. Oferecemos créditos flexíveis que variam de 25 mil a 4
          milhões de reais para veículos, com prazos de até 140 meses, e de 100 mil a 16 milhões para imóveis, com prazos de até 240 meses.
        </p>
        <p>
          Fomos pioneiros ao introduzir soluções inovadoras, como a meia parcela e a oferta de consórcio para investimento. A flexibilidade do nosso
          portfólio permite que nossos especialistas personalizem planos de investimento de acordo com as necessidades de cada cliente. Contamos ainda com
          grupos exclusivos para investidores, oferecendo cotas únicas de 2 milhões de reais.
        </p>
        <p>
          Com mais de 30 anos no mercado, somos a única administradora a proporcionar condições tão exclusivas para quem deseja investir em aumento de
          patrimônio de forma sólida e rentável.
        </p>
      </div>
      <ul class="sobre-destaques">
        {
          DESTAQUES.map((d) => (
            <li class="cartao">
              <strong>{d.valor}</strong>
              <span>{d.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao secao-cinza" id="historia-valores">
    <div class="container">
      <div class="secao-titulo">
        <span class="rotulo">Desde 1993</span>
        <h2>Nossa história</h2>
      </div>
      <LinhaDoTempo />
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="missao-visao">
        <article class="cartao">
          <span class="icone-caixa"><Icon nome="alvo" tamanho={26} /></span>
          <h2>Nossa missão</h2>
          <p>
            Empreender esforços para oportunizar o acesso aos bens de consumo desejados pelos nossos consorciados, a custos competitivos, prestando serviços
            de qualidade, garantindo excelência no atendimento e superando as expectativas de nossos clientes.
          </p>
        </article>
        <article class="cartao">
          <span class="icone-caixa"><Icon nome="olho" tamanho={26} /></span>
          <h2>Nossa visão</h2>
          <p>
            Ser uma empresa inovadora e líder de mercado, crescendo fortemente nos segmentos em que atua, encantando clientes e colaboradores ao proporcionar
            que o futuro esteja ao alcance de todos.
          </p>
        </article>
      </div>

      <div class="secao-titulo valores-titulo">
        <span class="rotulo">O que nos guia</span>
        <h2>Nossos valores</h2>
      </div>
      <ul class="valores">
        {
          VALORES.map((v) => (
            <li class="cartao">
              <span class="icone-caixa">
                <Icon nome={v.icone} tamanho={22} />
              </span>
              <h3>{v.titulo}</h3>
              <p>{v.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="grupo">
    <Image src={grupoHerval} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="grupo-foto" />
    <div class="container">
      <span class="rotulo">Grupo Herval</span>
      <h2>A HS Consórcios é uma empresa do Grupo Herval.</h2>
      <a href="https://www.herval.com.br" class="botao botao-claro" target="_blank" rel="noopener">Saiba mais sobre o grupo <Icon nome="externo" tamanho={16} /></a>
    </div>
  </section>

  <section class="secao secao-cinza" id="demonstracoes">
    <div class="container">
      <div class="secao-titulo">
        <span class="rotulo">Transparência</span>
        <h2>Demonstrações financeiras</h2>
        <p>Acompanhe as Demonstrações Semestrais e Anuais da Instituição.</p>
      </div>
      <ul class="documentos">
        {
          DEMONSTRACOES.map((d) => (
            <li>
              <a href={url(`/documentos/${d.arquivo}.pdf`)} target="_blank" rel="noopener" class="documento">
                <span class="documento-icone">
                  <Icon nome="documento" tamanho={22} />
                </span>
                <span>
                  <strong>{d.titulo}</strong>
                  <small>Demonstrações financeiras · PDF</small>
                </span>
                <Icon nome="baixar" tamanho={18} class="documento-baixar" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao" id="ouvidoria">
    <div class="container">
      <div class="secao-titulo">
        <span class="rotulo">Transparência</span>
        <h2>Relatórios de Ouvidoria</h2>
        <p>Acompanhe os Relatórios de Ouvidoria da Instituição.</p>
      </div>
      <ul class="documentos">
        {
          OUVIDORIA.map((d) => (
            <li>
              <a href={url(`/documentos/${d.arquivo}.pdf`)} target="_blank" rel="noopener" class="documento">
                <span class="documento-icone">
                  <Icon nome="documento" tamanho={22} />
                </span>
                <span>
                  <strong>{d.titulo}</strong>
                  <small>Relatório da Ouvidoria · PDF</small>
                </span>
                <Icon nome="baixar" tamanho={18} class="documento-baixar" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao secao-cinza" id="trabalheconosco">
    <div class="container trabalhe">
      <div class="trabalhe-fotos">
        <Image src={trabalhe1} alt="Equipe da HS Consórcios" widths={[400, 800]} sizes="(max-width: 860px) 50vw, 280px" />
        <Image src={trabalhe2} alt="Colaboradores da HS Consórcios" widths={[400, 800]} sizes="(max-width: 860px) 50vw, 280px" />
      </div>
      <div>
        <span class="rotulo">Carreiras</span>
        <h2>Faça parte do time HS Consórcios</h2>
        <p>Venha fazer parte do nosso time e vamos juntos construir uma história de sucesso na HS Consórcios!</p>
        <div class="trabalhe-botoes">
          <a href={url('/contato/')} class="botao">Seja um corretor HS Consórcios <Icon nome="seta" tamanho={18} /></a>
          <a href="https://hsconsorcios.gupy.io/" class="botao botao-contorno" target="_blank" rel="noopener">
            <Icon nome="maleta" tamanho={18} /> Trabalhe conosco
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container faq-bloco">
      <div class="faq-bloco-intro">
        <span class="rotulo">Tire suas dúvidas</span>
        <h2>Perguntas frequentes</h2>
        <p>Os termos mais usados no consórcio, explicados de forma simples.</p>
        <a href={url('/simulador/')} class="botao">Simule agora <Icon nome="seta" tamanho={18} /></a>
      </div>
      <div>
        <Faq quantidade={4} />
      </div>
    </div>
  </section>
</Base>

<style>
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    align-items: start;
    gap: 48px 72px;
  }

  .sobre h1 {
    font-size: clamp(2.1rem, 1.6rem + 2vw, 3rem);
  }

  .sobre p {
    color: var(--suave);
  }

  .sobre .destaque-texto {
    color: var(--grafite);
    font-size: 1.2rem;
    line-height: 1.55;
  }

  .sobre-destaques {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sobre-destaques li {
    display: grid;
    gap: 2px;
    padding: 22px 24px;
    border-left: 4px solid var(--vermelho);
  }

  .sobre-destaques strong {
    color: var(--vermelho);
    font-size: 1.7rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .sobre-destaques span {
    color: var(--suave);
    font-size: 15px;
  }

  .icone-caixa {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 18px;
    border-radius: 14px;
    background: var(--vermelho-claro);
    color: var(--vermelho);
  }

  .missao-visao {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: clamp(56px, 7vw, 96px);
  }

  .missao-visao article {
    padding: 36px;
  }

  .missao-visao h2 {
    font-size: 1.6rem;
  }

  .missao-visao p {
    margin: 0;
    color: var(--suave);
    font-size: 1.05rem;
  }

  .valores {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .valores li {
    padding: 28px;
  }

  .valores h3 {
    margin-bottom: 8px;
  }

  .valores p {
    margin: 0;
    color: var(--suave);
    font-size: 15px;
  }

  .grupo {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 420px;
    overflow: hidden;
    color: var(--branco);
  }

  .grupo :global(.grupo-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .grupo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgb(17 24 39 / 0.85) 0%, rgb(17 24 39 / 0.4) 70%, transparent 100%);
  }

  .grupo .container {
    position: relative;
    z-index: 2;
  }

  .grupo .rotulo,
  .grupo h2 {
    color: var(--branco);
  }

  .grupo h2 {
    max-width: 560px;
    margin-bottom: 28px;
  }

  .trabalhe {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px 72px;
  }

  .trabalhe-fotos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .trabalhe-fotos :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--raio-grande);
    object-fit: cover;
  }

  .trabalhe-fotos :global(img:last-child) {
    margin-top: 48px;
  }

  .trabalhe p {
    color: var(--suave);
    font-size: 1.1rem;
  }

  .trabalhe-botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  @media (max-width: 960px) {
    .sobre,
    .trabalhe {
      grid-template-columns: 1fr;
    }

    .sobre-destaques {
      grid-template-columns: repeat(2, 1fr);
    }

    .valores {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .missao-visao,
    .valores,
    .sobre-destaques {
      grid-template-columns: 1fr;
    }

    .missao-visao article {
      padding: 28px 24px;
    }
  }
</style>
